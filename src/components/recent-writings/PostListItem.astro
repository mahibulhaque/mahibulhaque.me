---
import { getCategory, getPostHref, formatPostDate } from "@/utils/post";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blogs">;
}

const { post } = Astro.props;
const category = getCategory(post);
const href = getPostHref(post);
const dateLabel = formatPostDate(post.data.date);
---

<li>
  <a
    href={href}
    class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8"
  >
    <div class="text-muted-foreground text-xs tracking-wide uppercase">
      <p>{dateLabel}</p>
      <p>{category}</p>
    </div>

    <div class="flex flex-col gap-2">
      <h3
        class="text-foreground text-xl font-semibold group-hover:underline sm:text-2xl"
      >
        {post.data.title}
      </h3>
      {
        post.data.description && (
          <p class="text-muted-foreground text-sm sm:text-base">
            {post.data.description}
          </p>
        )
      }
    </div>
  </a>
</li>
