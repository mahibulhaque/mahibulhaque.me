---
import { getCategory, getPostHref, formatPostDate } from "@/utils/post";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blogs">;
}

const { post } = Astro.props;
const category = getCategory(post);
const href = getPostHref(post);
const dateLabel = formatPostDate(post.data.date);
---

<li>
  <div class="flex w-full flex-col gap-2 py-6">
    <div
      class="text-muted-foreground flex items-center gap-2 text-xs tracking-wide uppercase"
    >
      <p>{dateLabel}</p>
      <a href={`${category}`} class="hover:text-link border-l pl-2"
        >{category}</a
      >
    </div>

    <div class="flex flex-col gap-2">
      <a
        href={href}
        class="text-foreground hover:text-link max-w-fit text-xl font-semibold sm:text-2xl"
      >
        {post.data.title}
      </a>
      {
        post.data.description && (
          <p class="text-muted-foreground text-sm sm:text-base">
            {post.data.description}
          </p>
        )
      }
    </div>
  </div>
</li>
