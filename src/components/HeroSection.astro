---
import { Image } from "astro:assets";
import { IconArrowDown } from "./icons/arrow-down";
import { IconArrowUpRight, IconBluesky, IconRSS } from "./icons";
import { IconMail } from "./icons";
import type { IconType } from "./icons";

interface SocialLink {
  label: string;
  href: string;
  icon: IconType;
}
interface CTA {
  label: string;
  href: string;
}

const DEFAULT_SOCIAL_LINKS: SocialLink[] = [
  {
    label: "Email",
    href: "mailto:hello@example.com",
    icon: IconMail,
  },
  {
    label: "Bluesky",
    href: "https://bsky.app",
    icon: IconBluesky,
  },
  {
    label: "RSS feed",
    href: "/rss.xml",
    icon: IconRSS,
  },
];

const DEFAULT_PRIMARY_CTA: CTA = {
  label: "Read the latest",
  href: "#recent-writing",
};

const DEFAULT_SECONDARY_CTA: CTA = {
  label: "About Mahib",
  href: "/about",
};

const HERO_SECTION_DEFAULTS = {
  eyebrow: "Independent field notes",
  coordinates: "52.5200° N · 13.4050° E",
  name: "Mahibul Haque",
  role: "Software Engineer",
  location: "Dhaka",
  greeting: "Hi, I'm Mahib.",
  tagline: "I work with computers.",
  subtext: "…and sometimes I write about them too.",
  postCount: 237,
  sinceYear: 2020,
  heroImageSrc:
    "https://images.unsplash.com/photo-1569412148958-600837f89a65?fm=jpg&q=80&w=1200&auto=format&fit=crop",
  heroImageAlt: "A weathered, wind-carved tree trunk in black and white",
} as const;
---

<section
  aria-label="Introduction"
  class="relative mx-auto max-w-6xl px-6 pt-6 pb-10 sm:px-10"
>
  <div
    class="border-border text-muted-foreground flex flex-wrap items-center justify-between gap-2 border-b pb-4 font-mono text-[11px] tracking-widest uppercase"
  >
    <p class="flex items-center gap-2">
      <span
        aria-hidden="true"
        class="bg-foreground/70 inline-block h-1.5 w-1.5 rounded-full"></span>

      {HERO_SECTION_DEFAULTS.eyebrow}
    </p>

    <p>{HERO_SECTION_DEFAULTS.coordinates}</p>
  </div>

  <!-- Main hero grid -->
  <div class="grid gap-10 pt-10 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <p
        class="text-muted-foreground font-mono text-[11px] tracking-widest uppercase"
      >
        {HERO_SECTION_DEFAULTS.name}
        <span aria-hidden="true">/</span>
        {HERO_SECTION_DEFAULTS.role}
        <span aria-hidden="true">/</span>
        {HERO_SECTION_DEFAULTS.location}
      </p>

      <h1
        class="text-foreground mt-4 text-5xl leading-[0.95] font-medium tracking-tight sm:text-6xl md:text-7xl"
      >
        {HERO_SECTION_DEFAULTS.greeting}

        <span class="text-muted-foreground block">
          {HERO_SECTION_DEFAULTS.tagline}
        </span>
      </h1>

      <p
        class="border-border text-muted-foreground mt-6 border-l-2 pl-4 text-sm sm:text-base"
      >
        {HERO_SECTION_DEFAULTS.subtext}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={DEFAULT_PRIMARY_CTA.href}
          class="bg-foreground text-background focus-visible:outline-ring inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-offset-2"
        >
          {DEFAULT_PRIMARY_CTA.label}

          <!-- Arrow down -->
          <IconArrowDown />
        </a>

        <a
          href={DEFAULT_SECONDARY_CTA.href}
          class="border-border text-foreground hover:bg-foreground/5 focus-visible:outline-ring inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-offset-2"
        >
          {DEFAULT_SECONDARY_CTA.label}

          <!-- Arrow up right -->
          <IconArrowUpRight />
        </a>
      </div>
    </div>

    <div
      class="border-border relative aspect-4/5 w-full overflow-hidden rounded-sm border sm:max-h-[420px] lg:max-h-[460px]"
    >
      <Image
        src={HERO_SECTION_DEFAULTS.heroImageSrc}
        alt={HERO_SECTION_DEFAULTS.heroImageAlt}
        width={800}
        height={1000}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover contrast-125 grayscale"
      />
    </div>
  </div>

  <!-- Stats / social row -->
  <div
    class="border-border mt-10 flex flex-wrap items-center justify-between gap-4 border-t pt-6"
  >
    <p
      class="text-muted-foreground font-mono text-[11px] tracking-widest uppercase"
    >
      {HERO_SECTION_DEFAULTS.postCount} posts since
      {HERO_SECTION_DEFAULTS.sinceYear}.
    </p>

    <ul class="flex items-center gap-4">
      {
        DEFAULT_SOCIAL_LINKS.map((link) => {
          const { icon: Icon } = link;
          return (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                class="text-muted-foreground hover:text-foreground focus-visible:outline-ring transition-colors focus-visible:outline focus-visible:outline-offset-2"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  link.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <Icon className="h-4 w-4" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
