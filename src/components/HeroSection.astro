---
import { Image } from "astro:assets";
import { IconArrowDown } from "./icons/arrow-down";
import { IconArrowUpRight, IconBluesky, IconRSS } from "./icons";
import { IconMail } from "./icons";
import { getCollection } from "astro:content";
import { HERO_SECTION_INFO } from "@/config/site";

const publishedBlogs = await getCollection("blogs", ({ data }) => !data.draft);

const totalPublished = publishedBlogs.length;

const SOCIAL_LINKS = [
  {
    label: "Email",
    href: "mailto:haque.mahibul.md@gmail.com",
    icon: IconMail,
  },
  {
    label: "Bluesky",
    href: "https://bsky.app/profile/mahibul.bsky.social",
    icon: IconBluesky,
  },
  {
    label: "RSS feed",
    href: "/rss.xml",
    icon: IconRSS,
  },
] as const;
---

<section
  aria-label="Introduction"
  class="@container relative isolate mx-auto max-w-6xl overflow-x-clip px-6 pt-6 pb-10 before:pointer-events-none before:absolute before:top-[4%] before:left-[-34%] before:-z-10 before:aspect-square before:w-[min(52rem,82cqw)] before:bg-[radial-gradient(circle,color-mix(in_oklab,var(--foreground)_4%,transparent),transparent_67%)] before:blur-[2px] before:content-[''] sm:px-10"
>
  <div
    class="border-border text-muted-foreground flex flex-wrap items-center justify-between gap-2 border-b pb-4 font-mono text-[11px] tracking-widest uppercase"
  >
    <p class="flex items-center gap-2">
      <span
        aria-hidden="true"
        class="bg-foreground/70 inline-block h-1.5 w-1.5 rounded-full"></span>

      {HERO_SECTION_INFO.eyebrow}
    </p>

    <p class="hidden sm:inline">{HERO_SECTION_INFO.coordinates}</p>
  </div>

  <!-- Main hero grid -->
  <div class="grid gap-10 pt-10 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <p
        class="text-muted-foreground font-mono text-[11px] tracking-widest uppercase"
      >
        {HERO_SECTION_INFO.name}
        <span aria-hidden="true">/</span>
        {HERO_SECTION_INFO.role}
        <span aria-hidden="true">/</span>
        {HERO_SECTION_INFO.location}
      </p>

      <h1
        class="text-foreground mt-4 text-5xl leading-[0.95] font-medium tracking-tight sm:text-6xl md:text-7xl"
      >
        {HERO_SECTION_INFO.greeting}

        <span class="text-muted-foreground block">
          {HERO_SECTION_INFO.tagline}
        </span>
      </h1>

      <p
        class="border-border text-muted-foreground mt-6 border-l-2 pl-4 text-sm sm:text-base"
      >
        {HERO_SECTION_INFO.subtext}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={"#recent-writings"}
          class="bg-foreground text-background focus-visible:outline-ring inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-offset-2"
        >
          Read the latest

          <!-- Arrow down -->
          <IconArrowDown />
        </a>

        <a
          href={"/about"}
          class="border-border text-foreground hover:bg-foreground/5 focus-visible:outline-ring inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-offset-2"
        >
          About Mahib

          <!-- Arrow up right -->
          <IconArrowUpRight />
        </a>
      </div>
    </div>

    <div
      class="border-border relative aspect-4/5 w-full overflow-hidden rounded-sm border sm:max-h-[420px] lg:max-h-[460px]"
    >
      <Image
        src={HERO_SECTION_INFO.heroImageSrc}
        alt={HERO_SECTION_INFO.heroImageAlt}
        width={800}
        height={1000}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover contrast-125 grayscale"
      />
    </div>
  </div>

  <!-- Stats / social row -->
  <div
    class="border-border mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-b py-6"
  >
    <p
      class="text-muted-foreground font-mono text-[11px] tracking-widest uppercase"
    >
      {totalPublished} posts since {" "}
      {HERO_SECTION_INFO.sinceYear}.
    </p>

    <ul class="flex items-center gap-4">
      {
        SOCIAL_LINKS.map((link) => {
          const { icon: Icon } = link;
          return (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                class="text-muted-foreground hover:text-foreground focus-visible:outline-ring transition-colors focus-visible:outline focus-visible:outline-offset-2"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  link.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <Icon className="h-4 w-4" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
