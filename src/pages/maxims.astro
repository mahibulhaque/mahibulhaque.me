---
import Layout from "@/layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { siteConfig } from "@/config/site";

const entry = await getEntry("pages", "maxims");
if (!entry) throw new Error("maxims.md entry not found in content/pages");

const { Content } = await render(entry);
---

<Layout
  title="Maxims"
  description={entry.data.description}
  canonicalURL={`${siteConfig.url}/about`}
>
  <div class="my-8 mr-auto ml-auto max-w-3xl space-y-8 px-6">
    <h1 class="text-foreground text-3xl font-normal sm:text-5xl">
      {entry.data.title}
    </h1>
    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
